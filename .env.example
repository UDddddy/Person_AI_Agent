# ===== LLM 配置（必填）=====
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-api-base-url/v1
LLM_MODEL=your_model_name
LLM_PROVIDER=openai_compat

# ===== P2 · CORS 跨域白名单（CSV，留空 = 默认仅同机开发端口）=====
# 页面与 API 同源托管（http://127.0.0.1:8000/）时不需要配；
# 从其它端口/局域网 IP 访问前端时才登记对应 Origin：
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:8000,http://localhost:5500

# ===== 阶段10 · 存储后端（默认 sqlite，无需配置即可跑）=====
DB_BACKEND=sqlite

# ===== 阶段10 · MySQL 配置（拆分式，DB_BACKEND=mysql 时启用）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=agent

# 高级覆盖：填了下面这一行就无视上面 5 字段（粘完整 DSN 用法）
# MYSQL_DSN=mysql+pymysql://root:your_password@127.0.0.1:3306/agent?charset=utf8mb4

# ===== 阶段10 · Redis 中间层（留空 = 完全禁用）=====
# REDIS_URL=redis://127.0.0.1:6379/0

# ===== RAG P3 · 稠密 embedding（可插拔；三项留空 = BM25 稀疏，开箱即用）=====
# 三项全部填了才启用稠密检索（openai 兼容 /embeddings 端点，httpx 直连，
# 不依赖 openai SDK）。DeepSeek 官方无 embedding 端点，可换硅基流动
# / OpenAI / vLLM / one-api 网关等任意兼容服务。
# 启用后：ingest 入库自动写向量、检索自动 BM25+稠密 RRF 融合（前端侧栏可见）。
# 启用前已入库的旧文档没有向量：执行一次补向量——
#   python -c "import app.knowledge as k; print(k.backfill_vectors())"
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# ===== Web 上传附件 =====
# 上传目录：相对路径基于项目工作目录；默认 uploads/（在工具沙箱白名单内，
# Agent 可用 read_pdf / read_file / read_docx 读取）。如要放到 workdir 外，
# 必须同时用 AGENT_ALLOWED_ROOTS 显式授权，否则读取会被沙箱拒绝。
# UPLOAD_DIR=uploads
# 单文件大小上限（MB）
# UPLOAD_MAX_MB=20

# ===== 阶段13 · 上下文用量可视化与自动压缩 =====
# 模型上下文窗口（token）：前端"上下文用量条"的分母（硬上限）。
# 不同模型窗口不同，按实际模型改（如 DeepSeek 64K / 128K / 其他 32K 等）。
# LLM_CONTEXT_WINDOW=64000
# 自动压缩软阈值（token 估算）：链内消息超过它，下一轮自动压缩；
# 前端用量条上也会画出这条"压缩线"。
# 学习项目默认 2000 便于演示；生产环境建议按模型窗口 60%~70% 设。
# COMPACT_THRESHOLD=2000
